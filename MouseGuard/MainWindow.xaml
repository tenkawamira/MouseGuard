<Window x:Class="MouseGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MouseGuard.Controls"
        Title="鼠标卫士 MouseGuard"
        Width="1180" Height="780" MinWidth="980" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{DynamicResource AmbientGlowBrush}" IsHitTestVisible="False" />

        <!-- Title bar -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}">
                    <controls:DeviceGlyph Kind="Mouse" Width="14" Height="14" Foreground="White" />
                </Border>
                <TextBlock Text="鼠标卫士" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource PillBorderStyle}" Padding="6,2" Margin="8,0,0,0">
                    <TextBlock Text="BETA" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="最小化">
                    <Viewbox Width="12" Height="12">
                        <Path Data="M2,8 L12,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="最大化">
                    <Grid Width="12" Height="12">
                        <Path x:Name="MaximizeGlyph" Data="M2.5,2.5 L9.5,2.5 L9.5,9.5 L2.5,9.5 Z"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.1" />
                        <Path x:Name="RestoreGlyph" Data="M3.5,2.5 L9.5,2.5 L9.5,8.5 M2.5,4.5 L8.5,4.5 L8.5,10.5 L2.5,10.5 Z"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.05" Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click" ToolTip="关闭到托盘">
                    <Path Width="12" Height="12" Data="M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,22,20,18">
                        <TextBlock Text="控制台" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="安静地管理输入控制权" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" FontSize="12" />
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="NavigationList" Style="{StaticResource NavigationListStyle}"
                             ItemsSource="{Binding NavigationItems}" SelectionChanged="NavigationList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" FontSize="16"
                                               HorizontalAlignment="Left"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="16,10,16,16">
                        <Border Padding="12" CornerRadius="11" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGlobalLockActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusHeadline}" FontSize="10.5" Margin="7,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding PermissionLabel}" Style="{StaticResource CaptionTextStyle}" Margin="14,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding AppVersion, StringFormat=MouseGuard v{0} · 本地运行}" Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="9" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <Grid x:Name="PageHost" />
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" Background="{DynamicResource ElevatedBackgroundBrush}"
                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.42" Color="#05070C" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ToastGlyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastTone}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" FontSize="11.5" Margin="2,0,14,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="DismissToast_Click" ToolTip="关闭">
                    <Path Width="8" Height="8" Data="M1,1 L7,7 M7,1 L1,7" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.1" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
