<Window x:Class="MouseGuard.Dialogs.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border Margin="20" CornerRadius="18" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.4" Color="#05070C" />
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="重命名设备" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Text="设置一个容易识别的名称，仅保存在本机。" Style="{StaticResource CaptionTextStyle}"
                       Margin="0,5,0,0" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" Grid.Row="2" Style="{StaticResource FluentTextBoxStyle}" Margin="0,18,0,0" MaxLength="40" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="Cancel_Click" Height="36" MinWidth="74" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存" Click="Save_Click" Height="36" MinWidth="84" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
