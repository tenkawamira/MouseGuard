<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>MouseGuard.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MouseGuard</AssemblyName>
    <RootNamespace>MouseGuard</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>鼠标卫士 MouseGuard</Product>
    <Description>管理鼠标与键盘控制权的 Windows 桌面工具</Description>
    <Company>MouseGuard</Company>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <None Remove="Assets\app-1024.png" />
  </ItemGroup>

</Project>
