<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#0E1118" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0D1017" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#141922" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#19202B" />
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#1B222E" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#10151E" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1B2332" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#161D28" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#252D3B" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#333D4E" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1E2633" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA7B9" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6D798B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6D8DFF" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#5678F5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2949" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#BFCCFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5BD6A6" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12352B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2A14" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7180" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A171E" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7B8799" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#2A3242" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="#C42B1C" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C9BFF" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5B7DFF" Offset="0" />
        <GradientStop Color="#8A6BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E2D4E" Offset="0" />
        <GradientStop Color="#181D2B" Offset="0.55" />
        <GradientStop Color="#121620" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#222B45" Offset="0" />
        <GradientStop Color="#141925" Offset="0.6" />
        <GradientStop Color="#0F131B" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.75,0.05" GradientOrigin="0.75,0.05" RadiusX="0.8" RadiusY="0.9">
        <GradientStop Color="#2B3E78" Offset="0" />
        <GradientStop Color="#000B0D12" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
