<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#EEF1F7" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F8F9FC" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F7F9FD" />
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E8EDFB" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#EFF2F8" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#E4E8F0" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#D4DAE6" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E9EDF4" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17202E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D6B7F" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8994A6" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4267E8" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#3154D6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9EEFC" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3154D6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F9D6B" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E3F6EE" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B96B00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1DC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D33B4C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCE8EA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7B8799" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#D5DBE5" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="#C42B1C" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4267E8" Offset="0" />
        <GradientStop Color="#7C5CE6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4267E8" Offset="0" />
        <GradientStop Color="#7157E8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8EEFF" Offset="0" />
        <GradientStop Color="#F3F5FC" Offset="0.6" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#222B45" Offset="0" />
        <GradientStop Color="#141925" Offset="0.6" />
        <GradientStop Color="#0F131B" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.75,0.05" GradientOrigin="0.75,0.05" RadiusX="0.8" RadiusY="0.9">
        <GradientStop Color="#DDE7FF" Offset="0" />
        <GradientStop Color="#00F4F6FA" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
