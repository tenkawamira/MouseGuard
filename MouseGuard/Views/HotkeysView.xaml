<UserControl x:Class="MouseGuard.Views.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,24,34,44">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="快捷键" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="把控制权交给一组熟悉的按键。任意应用中均可触发，也可以限定来源设备。"
                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddHotkeyCommand}"
                        Content="+  新建快捷键" VerticalAlignment="Center" />
            </Grid>

            <!-- Hint -->
            <Border CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" BorderBrush="#334D6DFF" BorderThickness="1"
                    Padding="16,13" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9" Background="#264D6DFF" VerticalAlignment="Center">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="设备感知快捷键" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock Text="可以为快捷键指定来源设备：只有该鼠标或键盘上的操作才会触发，适合多设备同机场景。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource PillBorderStyle}" Background="#1E2D49" VerticalAlignment="Center">
                        <TextBlock Text="无需驱动" FontSize="9.5" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Hotkeys}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18,15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="12,10" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GestureText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Text="GLOBAL SHORTCUT" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActionName}" Style="{StaticResource CardTitleTextStyle}" />
                                        <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource WarningSoftBrush}" Padding="6,2" Margin="8,0,0,0"
                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="内置" FontSize="8.5" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActionDescription}" Style="{StaticResource BodyTextStyle}" FontSize="11.5" Margin="0,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="目标" Style="{StaticResource CaptionTextStyle}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TargetSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Foreground="{DynamicResource TextTertiaryBrush}" Margin="9,0" VerticalAlignment="Center" />
                                        <TextBlock Text="来源" Style="{StaticResource CaptionTextStyle}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SourceSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  ToolTip="启用 / 停用快捷键" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.EditHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="编辑">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.DeleteHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="删除" IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Emergency -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="18,15" Margin="0,2,0,0" Background="{DynamicResource AppBackgroundAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="#33FFB454" BorderThickness="1"
                            CornerRadius="11" Padding="10,10" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Ctrl + Alt + Shift + Esc" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="紧急释放" Style="{StaticResource CardTitleTextStyle}" />
                            <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource WarningSoftBrush}" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="受保护" FontSize="8.5" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="无论当前处于何种接管状态，这个组合键都会立即释放全部鼠标与键盘控制。不可修改或删除。"
                                   Style="{StaticResource BodyTextStyle}" FontSize="11.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="17"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                </Grid>
            </Border>

            <TextBlock Text="提示：快捷键在鼠标被软件接管时仍然有效；如果键盘被禁用，请使用另一台键盘或管理员界面释放。"
                       Style="{StaticResource CaptionTextStyle}" Margin="2,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
