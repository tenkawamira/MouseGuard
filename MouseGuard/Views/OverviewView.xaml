<UserControl x:Class="MouseGuard.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MouseGuard.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,24,34,44">
            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="总览设备与快捷操作，随时掌握输入控制权。" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PillBorderStyle}">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MiceLocked}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MiceLocked}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding HeroStatusLabel}" FontSize="10.5" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MiceLocked}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="标准权限" FontSize="10.5" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Hero -->
            <Border CornerRadius="20" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="28,26"
                    Background="{DynamicResource HeroGradientBrush}" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource PillBorderStyle}" Background="#242E49">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MiceLocked}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding HeroStatusLabel}" FontSize="10.5" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MiceLocked}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding HeroTitle}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="29"
                                   FontWeight="SemiBold" Foreground="#F8FAFF" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HeroDescription}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                   Foreground="#AEBBD1" MaxWidth="480" Margin="0,9,0,0" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleMiceCommand}"
                                    Content="{Binding GlobalLockLabel}" MinWidth="138" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReleaseAllCommand}"
                                    Content="释放全部" Margin="10,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="2,15,0,0">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                       Foreground="#6F87B5" VerticalAlignment="Center" />
                            <TextBlock Text="紧急释放  Ctrl + Alt + Shift + Esc" FontSize="10.5" Foreground="#7283A2" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Control visual -->
                    <Grid Grid.Column="1" Height="238" HorizontalAlignment="Right" Width="268">
                        <Ellipse Width="218" Height="218" Stroke="#2C467E" StrokeThickness="1" Opacity="0.55" />
                        <Ellipse Width="166" Height="166" Stroke="#36518D" StrokeThickness="1" Opacity="0.45" />
                        <Ellipse Width="118" Height="118" Fill="#10203D" Opacity="0.75" />
                        <Border Width="102" Height="102" CornerRadius="30" Background="{DynamicResource AccentGradientBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.5" Color="#315BFF" />
                            </Border.Effect>
                            <Grid>
                                <controls:DeviceGlyph Kind="Mouse" Width="48" Height="48" Foreground="White" />
                                <Border Width="27" Height="27" CornerRadius="9" Background="#F4F7FB"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                               Foreground="#3154D6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,26,0,0" Style="{StaticResource PillBorderStyle}" Background="#16263E">
                            <TextBlock Text="TAKE CONTROL" FontSize="8.5" FontWeight="SemiBold" Foreground="#7FA7FF" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,22" Style="{StaticResource PillBorderStyle}" Background="#182A2A">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="LOW LATENCY" FontSize="8.5" FontWeight="SemiBold" Foreground="#7BD7B5" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="17,15" Margin="0,0,5,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding MouseCount}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="已连接鼠标" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <controls:DeviceGlyph Kind="Mouse" Width="19" Height="19" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="17,15" Margin="5,0,5,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding KeyboardCount}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="已连接键盘" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1B2B2D" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <controls:DeviceGlyph Kind="Keyboard" Width="19" Height="19" Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="17,15" Margin="5,0,5,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding TakenOverCount}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="已接管设备" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="17,15" Margin="5,0,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding HotkeyCount}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="生效快捷键" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#25233A" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="#B3A2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Devices + activity -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20,17" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已连接设备" Style="{StaticResource SectionTitleTextStyle}" />
                                <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource AccentSoftBrush}" Margin="10,0,0,0" Padding="7,2">
                                    <TextBlock Text="{Binding Devices.Count}" FontSize="9.5" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Style="{StaticResource QuietButtonStyle}" Content="管理全部  ›" HorizontalAlignment="Right"
                                    Command="{Binding NavigateCommand}" CommandParameter="devices" Padding="8,0" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" Height="53">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AppBackgroundAltBrush}"
                                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <controls:DeviceGlyph Kind="{Binding Kind}" Width="19" Height="19" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleTextStyle}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="7,3" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource PillBorderStyle}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTakenOver}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTakenOver}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ToggleButton Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding IsTakenOver, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" ToolTip="接管 / 释放" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20,17" Margin="7,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近操作" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="实时" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="9.5"
                                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                            <TextBlock Text="{Binding Text}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Shortcut strip -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="170">
                        <TextBlock Text="快捷指令" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="在任何应用中即时响应" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Hotkeys}" Margin="12,0,12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,3,8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GestureText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActionName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="2" Style="{StaticResource QuietButtonStyle}" Content="管理快捷键  ›"
                            Command="{Binding NavigateCommand}" CommandParameter="hotkeys" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
