<UserControl x:Class="MouseGuard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,24,34,44">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="让鼠标卫士安静地融入课堂：启动方式、权限与外观。" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PermissionLabel}" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                    <!-- Startup -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="22,20">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="启动与驻留" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Text="登录后自动启动，安静地待在系统托盘。" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFontFamily}" FontSize="17"
                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开机自动启动" FontSize="12.5" />
                                    <TextBlock Text="登录后静默驻留托盘，不弹出主窗口" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                              IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="{Binding AutoStartStatus}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" />

                            <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,15,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="手动启动时也隐藏到托盘" FontSize="12.5" />
                                    <TextBlock Text="开机启动始终静默；开启后双击程序也直接驻留托盘" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                              IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                            </Grid>

                            <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,15,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最小化时隐藏到托盘" FontSize="12.5" />
                                    <TextBlock Text="关闭窗口时不退出，快捷键继续生效" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Permission -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="22,20" Margin="0,13,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="权限" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Text="设备级接管依赖 Windows 设备管理接口。" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Border CornerRadius="12" Background="{DynamicResource AppBackgroundAltBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1" Padding="14,12" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding PermissionLabel}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="设备级接管 / 释放需要管理员权限；全局软件接管不受影响。"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="获取完整权限"
                                            Height="32" MinWidth="100" FontSize="10.5" Command="{Binding ElevateCommand}"
                                            Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="以管理员身份重启后，可以分别禁用指定的鼠标或键盘。程序退出时会自动恢复所有设备。"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Appearance -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="22,20" Margin="0,13,0,0">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Win11 Fluent 风格，跟随你的使用环境。" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Theme" Content="深色"
                                             IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}"
                                             CommandParameter="Dark" Margin="0,0,4,0" Padding="18,9" />
                                <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Theme" Content="浅色"
                                             IsChecked="{Binding IsLightTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}"
                                             CommandParameter="Light" Margin="4,0" Padding="18,9" />
                                <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Theme" Content="跟随系统"
                                             IsChecked="{Binding IsSystemTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}"
                                             CommandParameter="System" Margin="4,0,0,0" Padding="18,9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <!-- Data -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="设置和快捷键以 JSON 文件保存在本机，不上传任何数据。" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,13" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="11,9">
                                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MonoCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="打开数据目录" Height="33" FontSize="10.5"
                                        Command="{Binding OpenDataFolderCommand}" />
                                <Button Style="{StaticResource DangerQuietButtonStyle}" Content="恢复默认" Height="33" FontSize="10.5"
                                        Command="{Binding ResetSettingsCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20,18" Margin="0,13,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentGradientBrush}">
                                    <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFontFamily}" FontSize="19"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="鼠标卫士" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="MouseGuard" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource AccentSoftBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="9" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="多设备输入控制台。支持设备级接管、设备感知快捷键和不抢焦点的接管提示。"
                                       Style="{StaticResource BodyTextStyle}" FontSize="11.5" Margin="0,14,0,0" />
                            <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,14,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="无驱动 · 无网络请求 · 退出自动恢复设备" Style="{StaticResource CaptionTextStyle}" Margin="7,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Safety -->
                    <Border CornerRadius="16" Background="{DynamicResource WarningSoftBrush}" BorderBrush="#33FFB454" BorderThickness="1"
                            Padding="18,16" Margin="0,13,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="安全兜底" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="程序不会允许禁用最后一台键盘。任何情况下都可以按 Ctrl + Alt + Shift + Esc 紧急释放全部控制。"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
