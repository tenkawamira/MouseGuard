<UserControl x:Class="MouseGuard.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MouseGuard.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,24,34,44">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="设备" Style="{StaticResource PageTitleTextStyle}" />
                        <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource AccentSoftBrush}" Margin="12,5,0,0">
                            <TextBlock Text="{Binding DeviceSummary}" FontSize="10.5" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="识别每一只鼠标与键盘，分别接管、释放，或为它绑定专属快捷键。" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshDevicesCommand}"
                        Content="重新扫描" VerticalAlignment="Center" />
            </Grid>

            <!-- Permission banner -->
            <Border CornerRadius="14" Background="{DynamicResource WarningSoftBrush}" BorderBrush="#33FFB454" BorderThickness="1"
                    Padding="16,13" Margin="0,0,0,16"
                    Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9" Background="#26FFB454" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="需要管理员权限才能接管单个设备" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding AdminBannerText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="以管理员身份重启"
                            Command="{Binding ElevateCommand}" Height="34" MinWidth="132" FontSize="11.5" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Filter bar -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource FilterChipStyle}" Content="全部" GroupName="DeviceFilter"
                                 IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                                 Command="{Binding SetDeviceFilterCommand}" CommandParameter="all" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterChipStyle}" Content="鼠标" GroupName="DeviceFilter"
                                 IsChecked="{Binding IsMouseFilter, Mode=OneWay}"
                                 Command="{Binding SetDeviceFilterCommand}" CommandParameter="mouse" Margin="4,0" />
                    <RadioButton Style="{StaticResource FilterChipStyle}" Content="键盘" GroupName="DeviceFilter"
                                 IsChecked="{Binding IsKeyboardFilter, Mode=OneWay}"
                                 Command="{Binding SetDeviceFilterCommand}" CommandParameter="keyboard" Margin="4,0,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Width="280" Height="36" CornerRadius="9" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <Grid Margin="11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBlock Text="搜索名称或设备路径" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                     BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="11.5" VerticalContentAlignment="Center" Padding="0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- List -->
            <ItemsControl ItemsSource="{Binding VisibleDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="17,15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AppBackgroundAltBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <controls:DeviceGlyph Kind="{Binding Kind}" Width="24" Height="24"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleTextStyle}" FontSize="13.5" />
                                        <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource InputBackgroundBrush}"
                                                Padding="6,2" Margin="8,0,0,0"
                                                Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="虚拟" FontSize="8.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding DevicePath}" Style="{StaticResource MonoCaptionTextStyle}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DevicePath}" />
                                </StackPanel>

                                <Border Grid.Column="2" Padding="9,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PillBorderStyle}">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTakenOver}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTakenOver}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" FontSize="9.5" Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTakenOver}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Button Style="{StaticResource QuietButtonStyle}" Height="30" Padding="8,0" FontSize="10.5"
                                            Command="{Binding DataContext.BindDeviceHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="为这台设备绑定接管快捷键">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFontFamily}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="快捷键" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="2,0,0,0"
                                            Command="{Binding DataContext.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="重命名设备">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                            Command="{Binding DataContext.CopyDeviceIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="复制设备路径">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToggleLabel}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsTakenOver, Mode=OneWay}"
                                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                  Command="{Binding DataContext.ToggleDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" ToolTip="接管 / 释放这台设备" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="40" Margin="0,4,0,0"
                    Visibility="{Binding IsDeviceListEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFontFamily}" FontSize="24"
                                   Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyDeviceText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="连接鼠标或键盘后点击右上角「重新扫描」。" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="设备信息由 Windows 即插即用服务提供。接管单个设备会暂时禁用该设备，退出程序时自动恢复。"
                       Style="{StaticResource CaptionTextStyle}" Margin="2,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
