<UserControl x:Class="MouseGuard.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MouseGuard.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,24,34,44">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="接管提示" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="当控制权发生变化时，用一张不打扰课堂的卡片告知现场。" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestPopupCommand}"
                        Content="预览弹窗" VerticalAlignment="Center" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Form -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="22,20" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="文案与样式" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="提示会在接管动作发生后出现在屏幕上层，不抢占键盘焦点。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,18" />

                        <TextBlock Text="标题" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource FluentTextBoxStyle}" Text="{Binding Settings.Popup.Title, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="24" />

                        <TextBlock Text="说明文字" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,6" />
                        <TextBox Style="{StaticResource FluentTextBoxStyle}" Text="{Binding Settings.Popup.Message, UpdateSourceTrigger=PropertyChanged}"
                                 Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" MaxLength="80" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="停留时长" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PopupDurationLabel}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Popup.DurationSeconds, Mode=TwoWay}" Margin="0,7,0,0" />

                        <TextBlock Text="出现位置" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6" />
                        <ComboBox Style="{StaticResource FluentComboBoxStyle}" ItemsSource="{Binding PopupPositions}"
                                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedPopupPosition, Mode=TwoWay}" />

                        <TextBlock Text="强调色" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="PopupAccent" Margin="0,0,5,0"
                                         IsChecked="{Binding IsBlueAccent, Mode=OneWay}"
                                         Command="{Binding SetPopupAccentCommand}" CommandParameter="Blue">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#6D8DFF" VerticalAlignment="Center" />
                                    <TextBlock Text="星蓝" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="PopupAccent" Margin="5,0"
                                         IsChecked="{Binding IsVioletAccent, Mode=OneWay}"
                                         Command="{Binding SetPopupAccentCommand}" CommandParameter="Violet">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#A78BFA" VerticalAlignment="Center" />
                                    <TextBlock Text="紫罗兰" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="PopupAccent" Margin="5,0,0,0"
                                         IsChecked="{Binding IsGreenAccent, Mode=OneWay}"
                                         Command="{Binding SetPopupAccentCommand}" CommandParameter="Green">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#5BD6A6" VerticalAlignment="Center" />
                                    <TextBlock Text="薄荷" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="显示设备名称" FontSize="12" />
                                <TextBlock Text="在提示卡片中显示被接管设备的名称" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.Popup.ShowDeviceName, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="显示页脚签名" FontSize="12" />
                                <TextBlock Text="默认关闭，保持提示干净；可自定义一行小字" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.Popup.ShowFooterBranding, Mode=TwoWay}" />
                        </Grid>
                        <TextBox Style="{StaticResource FluentTextBoxStyle}" Margin="0,9,0,0" MaxLength="48"
                                 Text="{Binding Settings.Popup.FooterText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Settings.Popup.ShowFooterBranding}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="恢复默认" Command="{Binding ResetPopupCommand}" Height="34" />
                            <TextBlock Text="修改会实时保存" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20,18" Margin="9,0,0,0"
                        Background="{DynamicResource AppBackgroundAltBrush}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitleTextStyle}" />
                            <Border Style="{StaticResource PillBorderStyle}" Background="{DynamicResource SuccessSoftBrush}" HorizontalAlignment="Right" Padding="7,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="不抢焦点" FontSize="9" Foreground="{DynamicResource SuccessBrush}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border CornerRadius="20" Background="{DynamicResource PopupGradientBrush}"
                                Margin="0,16,0,0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" CornerRadius="20" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.9" RadiusY="1">
                                            <GradientStop Color="#22FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Grid.Row="0" Margin="20,18,20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="52" Height="52" VerticalAlignment="Top">
                                        <Border CornerRadius="15" Background="#24304A" BorderBrush="#2EFFFFFF" BorderThickness="1" />
                                        <controls:DeviceGlyph Kind="Mouse" Width="27" Height="27" Foreground="#EAF0FF" />
                                        <Border Width="20" Height="20" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" FontSize="8"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="控制权变更" FontSize="7.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="{Binding Settings.Popup.Title}" FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="19" FontWeight="SemiBold" Foreground="#F7F9FF" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Settings.Popup.Message}" FontSize="10.5" LineHeight="16"
                                                   Foreground="#AEB9CC" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#1FFFFFFF" CornerRadius="0,0,20,20" Padding="20,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="已连接的鼠标" FontSize="9.5" Foreground="#C7D3EA" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Settings.Popup.FooterText}" FontSize="8.5" Foreground="#6F7C91"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding Settings.Popup.ShowFooterBranding, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Column="2" Text="单击任意位置关闭" FontSize="8.5" Foreground="#7D8AA0"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Margin="2,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="提示卡片不会获取键盘焦点" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="7,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="支持多显示器，按当前鼠标所在屏幕定位" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="7,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="课堂模式小贴士：把停留时长设为 4–6 秒，并选择屏幕中央；提示会短暂出现，不需要老师额外操作。"
                       Style="{StaticResource CaptionTextStyle}" Margin="2,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
