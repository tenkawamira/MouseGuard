<UserControl x:Class="MouseGuard.Controls.DeviceGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MouseGuard.Models"
             x:Name="Root" Width="24" Height="24"
             Foreground="{DynamicResource TextSecondaryBrush}">
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path x:Name="MouseShape"
                  Data="M12,2.2 C7.7,2.2 5.2,5.9 5.2,10.1 L5.2,13.5 C5.2,18 8.1,21.8 12,21.8 C15.9,21.8 18.8,18 18.8,13.5 L18.8,10.1 C18.8,5.9 16.3,2.2 12,2.2 Z"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1.55" Fill="Transparent"
                  StrokeLineJoin="Round" />
            <Path x:Name="WheelMark"
                  Data="M12,5.4 L12,9.2"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1.55" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Path x:Name="MouseSplit"
                  Data="M12,11.8 L12,18.6"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1.25" Opacity="0.42"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="KeyboardShape"
                  Data="M3.2,6.6 C3.2,5.5 4.1,4.6 5.2,4.6 L18.8,4.6 C19.9,4.6 20.8,5.5 20.8,6.6 L20.8,17.4 C20.8,18.5 19.9,19.4 18.8,19.4 L5.2,19.4 C4.1,19.4 3.2,18.5 3.2,17.4 Z"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1.55" Fill="Transparent"
                  StrokeLineJoin="Round" Visibility="Collapsed" />
            <Path x:Name="KeyboardKeys"
                  Data="M6.4,8.3 L8.3,8.3 M10.1,8.3 L12,8.3 M13.8,8.3 L15.7,8.3 M17.5,8.3 L17.5,8.3 M6.4,11 L8.3,11 M10.1,11 L12,11 M13.8,11 L15.7,11 M17.5,11 L17.5,11 M7.4,13.8 L7.4,16 L16.6,16 L16.6,13.8"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1.35" Opacity="0.78"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
            <Path x:Name="MouseBadge" Data="M18.4,17.2 L18.4,15.8 C18.4,15.1 18.9,14.6 19.6,14.6 C20.3,14.6 20.8,15.1 20.8,15.8 L20.8,17.2"
                  Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1.1" Visibility="Collapsed" />
        </Canvas>
    </Viewbox>
</UserControl>
