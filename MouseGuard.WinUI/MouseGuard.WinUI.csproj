<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MouseGuard.WinUI</RootNamespace>
    <AssemblyName>MouseGuard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
    <EnableDefaultAssets>true</EnableDefaultAssets>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Product>鼠标卫士 MouseGuard</Product>
    <Description>原生 WinUI 3 输入设备控制台</Description>
    <Company>MouseGuard</Company>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MouseGuard\Helpers\ObservableObject.cs" Link="Core\ObservableObject.cs" />
    <Compile Include="..\MouseGuard\Helpers\RelayCommand.cs" Link="Core\RelayCommand.cs" />
    <Compile Include="..\MouseGuard\Models\*.cs" Link="Core\Models\%(Filename)%(Extension)" />
    <Compile Include="..\MouseGuard\Services\SettingsService.cs" Link="Core\SettingsService.cs" />
    <Compile Include="..\MouseGuard\Services\LogService.cs" Link="Core\LogService.cs" />
    <Compile Include="..\MouseGuard\Services\DeviceService.cs" Link="Core\DeviceService.cs" />
    <Compile Include="..\MouseGuard\Services\AutoStartService.cs" Link="Core\AutoStartService.cs" />
    <Compile Include="..\MouseGuard\Native\SetupApiInterop.cs" Link="Core\SetupApiInterop.cs" />
    <Compile Include="..\MouseGuard\Native\HidInterop.cs" Link="Core\HidInterop.cs" />
    <Compile Include="..\MouseGuard\Native\NativeMethods.cs" Link="Core\NativeMethods.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\app.ico" />
  </ItemGroup>
</Project>
