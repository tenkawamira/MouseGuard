<Page
    x:Class="MouseGuard.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="设备" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="分别接管、释放每一只鼠标与键盘。" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="重新扫描" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar IsOpen="{Binding ShowAdminInfo}" IsClosable="False"
                     Severity="Warning" Title="需要管理员权限"
                     Message="接管设备需要管理员权限；授权后即可用开关单独控制每一台设备。">
                <InfoBar.ActionButton>
                    <Button Content="以管理员身份重启" Click="Elevate_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FilterCombo" Width="130" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="全部设备" Tag="all" />
                    <ComboBoxItem Content="鼠标" Tag="mouse" />
                    <ComboBoxItem Content="键盘" Tag="keyboard" />
                </ComboBox>
                <TextBox Grid.Column="1" PlaceholderText="搜索名称或设备路径" Text="{Binding SearchText, Mode=TwoWay}"
                         TextChanged="Search_TextChanged" />
            </Grid>

            <ListView ItemsSource="{Binding VisibleDevices}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource IconTileStyle}" Width="40" Height="40">
                                    <FontIcon Glyph="{Binding KindGlyph}" FontFamily="Segoe Fluent Icons" FontSize="18" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" />
                                        <Border CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding DevicePath}" FontFamily="Cascadia Mono"
                                               FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Padding="9,4" FontSize="11" Click="BindHotkey_Click"
                                            ToolTipService.ToolTip="为这台设备绑定快捷键">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                            <TextBlock Text="快捷键" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="9,4" FontSize="11" Content="重命名" Click="Rename_Click" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="3" IsOn="{Binding IsTakenOver, Mode=OneWay}"
                                              Toggled="DeviceToggle_Toggled" OnContent="" OffContent=""
                                              MinWidth="0" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding DisplayName}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Style="{StaticResource SettingsCardStyle}" Padding="24"
                    Visibility="{Binding EmptyVisibility}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="28"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="没有检测到输入设备" HorizontalAlignment="Center" />
                    <TextBlock Text="连接鼠标或键盘后点击右上角「重新扫描」。" Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="设备信息由 Windows 即插即用服务提供。打开开关即接管该设备；接收器重新插回时会自动释放。"
                       Style="{StaticResource CaptionStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
