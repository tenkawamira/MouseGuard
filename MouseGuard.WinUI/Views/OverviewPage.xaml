<Page
    x:Class="MouseGuard.WinUI.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="主页" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="管理鼠标与键盘的控制权。" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTileStyle}" Width="48" Height="48">
                        <FontIcon Glyph="{Binding StatusGlyph}" Style="{StaticResource SettingsGlyphStyle}" FontSize="22" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SettingsRowDescriptionStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="紧急释放" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="鼠标失灵或误接管时，随时用键盘恢复全部设备。" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,7" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmergencyHotkeyText}" FontFamily="Cascadia Mono" FontSize="11" />
                    </Border>

                    <Button Grid.Column="3" Content="立即释放" Click="ReleaseAll_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SettingsCardStyle}" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding MouseCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="已连接鼠标" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding KeyboardCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="已连接键盘" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TakenOverCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="当前已接管" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SettingsCardStyle}" Padding="0">
                <StackPanel>
                    <Grid Padding="16,14,12,10">
                        <TextBlock Text="已连接设备" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Padding="10,5" Click="Devices_Click">
                            <TextBlock Text="管理全部" FontSize="12" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTileStyle}" Width="34" Height="34">
                                        <FontIcon Glyph="{Binding KindGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="3" IsOn="{Binding IsTakenOver, Mode=OneWay}"
                                                  Toggled="DeviceToggle_Toggled" OnContent="" OffContent=""
                                                  MinWidth="0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding DisplayName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="没有检测到输入设备" Style="{StaticResource CaptionStyle}" Margin="16,8,16,16"
                               Visibility="{Binding EmptyVisibility}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="最近操作" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="13"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
