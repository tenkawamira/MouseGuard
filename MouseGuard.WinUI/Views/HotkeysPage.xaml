<Page
    x:Class="MouseGuard.WinUI.Views.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="快捷键" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="一个组合键可同时控制多台设备，也可限定来源设备。" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Content="+ 新建快捷键" Click="New_Click" />
            </Grid>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="设备感知快捷键"
                     Message="新建快捷键时可勾选多台目标设备；指定来源设备后，只有该设备上的操作才会触发。" />

            <Border Style="{StaticResource SettingsCardStyle}" Padding="24"
                    Visibility="{Binding HotkeyEmptyVisibility}">
                <StackPanel HorizontalAlignment="Center" Spacing="7">
                    <FontIcon Glyph="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="26"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="还没有自定义快捷键" HorizontalAlignment="Center" />
                    <TextBlock Text="点击右上角「新建快捷键」，一次选择多台设备。" Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding Hotkeys}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GestureText}" FontFamily="Cascadia Mono" FontSize="10.5"
                                               TextWrapping="NoWrap" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding ActionName}" FontSize="14" />
                                    <TextBlock Text="{Binding ActionDescription}" Style="{StaticResource CaptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="目标" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding TargetSummary}" Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="来源" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                              OnContent="" OffContent="" Header="启用" MinWidth="0" Toggled="HotkeyToggled"
                                              VerticalAlignment="Center" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Padding="9,4" FontSize="11" Content="编辑" Click="Edit_Click" />
                                    <Button Padding="9,4" FontSize="11" Content="删除" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Style="{StaticResource SettingsCardStyle}" Padding="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl + Alt + Shift + Esc" FontFamily="Cascadia Mono" FontSize="11" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="紧急释放" FontSize="14" />
                        <TextBlock Text="任何情况下立即释放全部鼠标和键盘控制，不可修改。" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="快捷键在任意应用中生效；鼠标被接管时仍可使用。"
                       Style="{StaticResource CaptionStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
