<Window
    x:Class="MouseGuard.WinUI.Views.TakeoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="接管提示">

    <Grid x:Name="Root" Background="Transparent" Padding="24,22,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="56" Height="56" VerticalAlignment="Top">
                <Border CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" />
                <FontIcon x:Name="DeviceIcon" Glyph="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="26"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border x:Name="LockBadge" Width="22" Height="22" CornerRadius="11"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                        BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="2">
                    <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="White" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="控制权变更" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleText" Text="鼠标已被接管" FontFamily="Segoe UI Variable Display"
                           FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Text="此设备的鼠标控制权已被接管"
                           FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
                <Border x:Name="DeviceChip" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        HorizontalAlignment="Left" Padding="9,4" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="DeviceDot" Width="5" Height="5" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="DeviceNameText" Text="已连接的鼠标" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="1.5" />
                <Border x:Name="CountdownBar" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.5"
                        HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <TextBlock x:Name="FooterBrandText" Text="鼠标卫士" FontSize="10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                <TextBlock Text="单击任意位置关闭" FontSize="10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
