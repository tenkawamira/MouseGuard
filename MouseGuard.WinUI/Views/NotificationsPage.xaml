<Page
    x:Class="MouseGuard.WinUI.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="接管提示" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="控制权变化时显示一张不抢焦点的浮层卡片。" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="预览弹窗" Click="Test_Click" />
            </Grid>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="通知方式" Style="{StaticResource SectionHeaderStyle}" Margin="0" />

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="显示接管弹窗" FontSize="13" />
                            <TextBlock Text="在屏幕角落显示不抢焦点的提示卡片" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right"
                                      IsOn="{Binding ShowTakeoverPopup, Mode=TwoWay}" />
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="使用 Windows 系统通知" FontSize="13" />
                            <TextBlock Text="发送原生 Toast；不可用时自动回退到接管弹窗" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right"
                                      IsOn="{Binding UseSystemNotifications, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="文案与样式" Style="{StaticResource SectionHeaderStyle}" Margin="0" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="标题" Style="{StaticResource CaptionStyle}" />
                        <TextBox Text="{Binding Settings.Popup.Title, Mode=TwoWay}" MaxLength="24" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="说明文字" Style="{StaticResource CaptionStyle}" />
                        <TextBox Text="{Binding Settings.Popup.Message, Mode=TwoWay}" MaxLength="80"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="停留时长" Style="{StaticResource CaptionStyle}" />
                            <Slider x:Name="DurationSlider" ValueChanged="Duration_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                            <TextBlock Text="{Binding Settings.Popup.DurationSeconds}" />
                            <TextBlock Text=" 秒后自动关闭" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="出现位置" Style="{StaticResource CaptionStyle}" />
                            <ComboBox ItemsSource="{Binding PopupPositions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPopupPosition, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="强调色" Style="{StaticResource CaptionStyle}" />
                            <ComboBox ItemsSource="{Binding PopupAccents}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPopupAccent, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="显示设备名称" FontSize="13" />
                            <TextBlock Text="在提示中显示被接管设备的名称" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding Settings.Popup.ShowDeviceName, Mode=TwoWay}" />
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="显示页脚签名" FontSize="13" />
                            <TextBlock Text="默认关闭；开启后可自定义一行小字" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding Settings.Popup.ShowFooterBranding, Mode=TwoWay}" />
                    </Grid>

                    <TextBox Text="{Binding Settings.Popup.FooterText, Mode=TwoWay}" MaxLength="48"
                             IsEnabled="{Binding Settings.Popup.ShowFooterBranding}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="恢复默认" Click="Reset_Click" />
                        <TextBlock Text="修改会实时保存" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="预览" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                    <Border CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="22,20" MaxWidth="520" HorizontalAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="控制权变更" FontSize="11"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Settings.Popup.Title}" FontSize="22" FontWeight="SemiBold"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Settings.Popup.Message}" Style="{StaticResource CaptionStyle}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                            <Border CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding DeviceNameVisibility}">
                                <TextBlock Text="已连接的鼠标" FontSize="11" />
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="{Binding Settings.Popup.FooterText}" Style="{StaticResource CaptionStyle}"
                                           Visibility="{Binding FooterVisibility}" />
                                <TextBlock Text="单击任意位置关闭" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="提示卡片使用系统亚克力背景，不获取键盘焦点。" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
